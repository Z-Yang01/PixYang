{
  "name": "pixyang",
  "version": "1.0.0",
  "description": "Local image management and browsing application",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run -s rebuild:electron && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder",
    "test": "npm run -s rebuild:node && vitest run",
    "test:coverage": "npm run -s rebuild:node && vitest run --coverage",
    "rebuild:electron": "node scripts/native.js electron",
    "rebuild:node": "node scripts/native.js node",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check .",
    "vite:dev": "vite",
    "electron:dev": "electron ."
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "sharp": "^0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.0.1",
    "electron": "^32.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.0",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.8",
    "vitest": "^3.2.7",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.pixyang.app",
    "productName": "PixYang",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PixYang"
    }
  }
}
