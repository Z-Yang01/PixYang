{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixYang",
  "version": "0.1.0",
  "identifier": "com.pixyang.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "PixYang",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$CONFIG/pixyang/images/**",
          "$CONFIG/pixyang/thumbnails/**"
        ]
      }
    }
  }
}
